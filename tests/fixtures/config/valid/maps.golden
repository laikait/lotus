File
  Directive "lotus_config_version" @1:1
    Int 1 "1" @1:22
  Directive "security_headers" @2:1
    Block @2:18-6:1
      Pair @3:5
        String @3:5 [text:"X-Frame-Options"]
        String @3:25 [text:"SAMEORIGIN"]
      Pair @4:5
        String @4:5 [text:"Referrer-Policy"]
        RawString @4:25 [text:"strict-origin"]
      Pair @5:5
        String @5:5 [text:"X-List"]
        List @5:16
          String @5:18 [text:"a"]
          String @5:23 [text:"b"]
